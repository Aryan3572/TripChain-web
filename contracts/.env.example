# Smart Contracts Environment Variables
# Used by hardhat.config.js for testnet/mainnet deployments

# Private key of the deployer wallet (ensure it has testnet funds: POL on Amoy, ETH on Sepolia)
# WARNING: Never commit actual private keys to Git!
DEPLOYER_PRIVATE_KEY=your_private_key_without_0x_or_with_0x

# Optional custom RPC URLs (defaults exist in hardhat.config.js)
POLYGON_AMOY_RPC_URL=https://rpc-amoy.polygon.technology
BASE_SEPOLIA_RPC_URL=https://sepolia.base.org
SEPOLIA_RPC_URL=https://rpc.sepolia.org

# Optional: Address of the validator signer (defaults to deployer address if omitted)
VALIDATOR_ADDRESS=
