# Docker Compose Root Environment Variables
# Copy to .env in the repository root to customize Docker Compose builds

# Frontend Build Arguments
REACT_APP_API_BASE=http://localhost:5000
REACT_APP_GOOGLE_CLIENT_ID=your_google_web_client_id.apps.googleusercontent.com
REACT_APP_MAPBOX_TOKEN=your_mapbox_token_here

# Redis Override (Optional - defaults to internal Docker redis container: redis://redis:6379)
REDIS_URL=
