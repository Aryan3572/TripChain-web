DATABASE_URL="postgresql://neondb_owner:password@ep-host-pooler.c-4.us-east-2.aws.neon.tech/neondb?sslmode=require&pgbouncer=true&connect_timeout=15"
DIRECT_URL="postgresql://neondb_owner:password@ep-host.c-4.us-east-2.aws.neon.tech/neondb?sslmode=require"
PORT=5000
JWT_SECRET=replace_with_a_long_random_jwt_secret
GOOGLE_CLIENT_ID=your_google_web_client_id.apps.googleusercontent.com

# Login Notification Alerts
ADMIN_NOTIFICATION_EMAIL=your_admin_email@gmail.com
GMAIL_USER=your_gmail@gmail.com
GMAIL_APP_PASSWORD=your_16_digit_app_password

# Redis Distributed Caching (Optional)
# In Docker Compose, this defaults automatically to redis://redis:6379
# For local dev without Docker, leave blank for fast in-memory cache, or paste Upstash URL:
REDIS_URL=

# Web3 Validator & Oracle Keys
